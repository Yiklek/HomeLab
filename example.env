# Shared homelab settings
DOMAIN=
DATA_BASE=

# DNS server used by services that need explicit resolution
DNS=

# Authentik
AUTHENTIK_TAG=2026.5.6
AUTHENTIK_PG_PASS=
AUTHENTIK_SECRET_KEY=
AUTHENTIK_DOMAIN_PROXY_TOKEN=
AUTHENTIK_LDAP_TOKEN=

# Portainer
PORTAINER_AGENT_SECRET=

# AdGuard Home
ADGUARD_AUTH=

# SiYuan
SIYUAN_AUTH_CODE=

# Optional outbound proxy for image pulls and downloads (mihomo mixed port)
# http_proxy=http://127.0.0.1:7890
# https_proxy=http://127.0.0.1:7890
http_proxy=
https_proxy=

# OxiDNS (extra/oxidns); directory must contain config.yaml
OXIDNS_CONFIG_DIR=

# network
# docker network inspect ${network} --format='{{with index .IPAM.Config 0 }}{{print .Gateway}}{{end}}'
TRAEFIK_GATEWAY=
AUTHENTIK_GATEWAY=

# Resolver used by the mail/webmail containers. It must be reachable
# from inside Docker and resolve both the local mail domain and
# external names (a router or a DNS server, not a host port).
MAIL_DNS_RESOLVER=192.168.1.1

# Stalwart mail server (user:password, bootstrap/recovery admin)
MAIL_SERVER_ADMIN=
# Public client ID of the Authentik mail OAuth2/OIDC provider
MAIL_OIDC_CLIENT_ID=
# Authentik users that should match username@DOMAIN through their UPN attribute
MAIL_OIDC_UPN_ACCOUNTS=
# auto|always: keep the Authentik identification form (passwordless entry point)
MAIL_OIDC_IDENTIFICATION=
# Optional comma-separated Stalwart admin accounts (explicit privilege grant)
MAIL_OIDC_ADMIN_ACCOUNTS=
# Authentik group whose members get the Stalwart Admin role (source of truth)
MAIL_OIDC_ADMIN_GROUP=mail-admins

# MetaCubeXD all-in-one server
METACUBEXD_CONTROL_TOKEN=
METACUBEXD_CLASH_SECRET=

# Mirrored GitHub prefix, used only when bootstrap GEO files are missing
GH_PROXY=https://gh-proxy.com/

# Bulwark webmail (JMAP) session secret: openssl rand -base64 32
WEBMAIL_SESSION_SECRET=
