# Shared homelab settings
DOMAIN=lab.example
DATA_BASE=/srv/homelab/data

# Generate with: openssl rand -base64 48
METACUBEXD_CONTROL_TOKEN=change-me-long-random-control-token
METACUBEXD_CLASH_SECRET=change-me-long-random-clash-secret

# Prefix used only when bootstrap GEO files are missing
GH_PROXY=https://gh-proxy.com/
