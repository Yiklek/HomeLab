# Stalwart bootstrap/recovery administrator, formatted as user:password.
# Generate the password with: openssl rand -hex 24
# Keep this strong recovery credential available for OIDC lockout recovery.
MAIL_SERVER_ADMIN=admin:change-me

# Authentik OAuth2/OIDC Provider client ID (public, not the client secret).
MAIL_OIDC_CLIENT_ID=change-me

# Optional overrides; defaults are derived from DOMAIN.
# MAIL_DOMAIN=lab.home
# MAIL_HOSTNAME=mail.lab.home
# MAIL_OIDC_ISSUER=https://auth.lab.home/application/o/mail/
# MAIL_OIDC_REQUIRED_SCOPES=openid,profile
# MAIL_OIDC_USERNAME_CLAIM=preferred_username
# MAIL_OIDC_USERNAME_DOMAIN=lab.home
# MAIL_OIDC_NAME_CLAIM=name
# MAIL_OIDC_GROUPS_CLAIM=groups
# Authentik usernames that should also match username@MAIL_DOMAIN through UPN.
# MAIL_OIDC_UPN_ACCOUNTS=yiklek
# auto (default) skips the identification form when the WebUI sends login_hint;
# always keeps the form so the passwordless/WebAuthn entry point stays reachable.
# MAIL_OIDC_IDENTIFICATION=always
# Explicit comma-separated Stalwart administrators; Authentik group names do not grant roles.
# MAIL_OIDC_ADMIN_ACCOUNTS=yiklek
# MAIL_WEBUI_OAUTH_CLIENT_ID=change-me
# AUTHENTIK_SERVER_CONTAINER=authentik-server

# Webmail (Bulwark). Set WEBMAIL_ENABLED=false to stop managing its
# callbacks/scope mapping from configure-authentik.py.
# WEBMAIL_ENABLED=true
# WEBMAIL_HOSTNAME=webmail.lab.home
# WEBMAIL_OFFLINE_ACCESS=true
# WEBMAIL_APP_NAME=Webmail

# Only Authentik groups whose name starts with this prefix become Stalwart
# shared mailboxes; the administrator group is excluded automatically.
# MAIL_OIDC_GROUP_PREFIX=mail-
