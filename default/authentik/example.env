# Shared homelab settings
DOMAIN=lab.example
DATA_BASE=/srv/homelab/data

AUTHENTIK_IMAGE=ghcr.io/goauthentik/server
AUTHENTIK_TAG=2025.2.4
AUTHENTIK_PG_USER=authentik
AUTHENTIK_PG_DB=authentik
AUTHENTIK_PG_PASS=change-me-database-password
AUTHENTIK_SECRET_KEY=change-me-long-random-secret
AUTHENTIK_DOMAIN_PROXY_TOKEN=change-me-outpost-token
AUTHENTIK_LDAP_TOKEN=change-me-ldap-outpost-token
AUTHENTIK_GATEWAY=172.19.0.1

AUTHENTIK_DISABLE_STARTUP_ANALYTICS=true
AUTHENTIK_DISABLE_UPDATE_CHECK=false
AUTHENTIK_ERROR_REPORTING__ENABLED=false
AUTHENTIK_LOG_LEVEL=info
AUTHENTIK_COOKIE_DOMAIN=lab.example

# Optional email settings
AUTHENTIK_EMAIL__HOST=
AUTHENTIK_EMAIL__PORT=587
AUTHENTIK_EMAIL__USERNAME=
AUTHENTIK_EMAIL__PASSWORD=
AUTHENTIK_EMAIL__USE_TLS=true
AUTHENTIK_EMAIL__USE_SSL=false
AUTHENTIK_EMAIL__TIMEOUT=10
AUTHENTIK_EMAIL__FROM=
